# Copy this file to .env and fill in real values. .env is gitignored.

# Jev / TypeSafe API key - https://typesafe.ai
TYPESAFE_API_KEY=

# Planner LLM: any OpenAI-compatible chat-completions gateway.
# planner_client.py authenticates with an `x-api-key` header (not
# `Authorization: Bearer`) and defaults to model "dev-model-alpha" -
# adjust planner_client.py if your gateway differs.
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://your-openai-compatible-gateway/v1
